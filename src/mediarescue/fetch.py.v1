"""Fetch an intact reference file from a link when the user only has a share URL.

The reference's *content* never matters, only the way it was encoded -- which is why a link is
often all that is available: the intact twin of a damaged download lives in someone's cloud
drive, not on this disk. Plain HTTP(S) is enough with the standard library; the share hosts that
merely wrap a file (Google Drive, Dropbox, OneDrive) are rewritten to their direct endpoints.
Mega is refused with an explanation instead of downloading 40 KB of JavaScript: its links are
encrypted in the browser and cannot be fetched without reimplementing their protocol.
"""
from __future__ import annotations

import re
import shutil
import urllib.error
import urllib.request
from pathlib import Path

MAX_BYTES = 4 << 30          # a reference is a video, not a disk image; refuse runaway downloads
CHUNK = 1 << 20
TIMEOUT = 30
USER_AGENT = "mediarescue/0.6 (+https://github.com/lutherrio25-svg/mediarescue)"


class FetchError(RuntimeError):
    """A link that looked usable but did not produce a media file."""


def is_url(text: str) -> bool:
    lowered = (text or "").strip().lower()
    return lowered.startswith(("http://", "https://"))


def looks_like_media(path: Path) -> bool:
    """Enough of a sniff to tell a video from the HTML page that wraps it.

    A share page is served as text/html with a 200 status and a plausible size, so the only
    honest check is the first bytes: ISO-BMFF, RIFF, EBML, Ogg, FLAC, MP3/AAC, FLV.
    """
    try:
        with open(path, "rb") as handle:
            head = handle.read(16)
    except OSError:
        return False
    if len(head) < 12:
        return False
    if head[4:8] in (b"ftyp", b"moov", b"mdat", b"free", b"wide", b"skip"):
        return True
    if head[:4] == b"RIFF" and head[8:12] in (b"AVI ", b"WAVE"):
        return True
    if head[:4] in (b"\x1aE\xdf\xa3", b"OggS", b"fLaC", b"FLV\x01"):
        return True
    if head[:3] == b"ID3":
        return True
    return head[0] == 0xFF and (head[1] & 0xE0) == 0xE0      # MPEG audio / ADTS


def direct_candidates(url: str) -> list[str]:
    """The URLs worth trying for `url`, most-likely-direct first."""
    url = url.strip()
    lowered = url.lower()
    if "mega.nz" in lowered or "mega.io" in lowered:
        raise FetchError(
            "Mega links are decrypted in the browser, so they cannot be fetched from here. "
            "Download the file in your browser, then pass the downloaded file instead of the link.")
    if "drive.google.com" in lowered or "docs.google.com" in lowered:
        match = (re.search(r"/file/d/([\w-]{10,})", url)
                 or re.search(r"[?&]id=([\w-]{10,})", url))
        if match:
            file_id = match.group(1)
            return [f"https://drive.usercontent.google.com/download?id={file_id}"
                    f"&export=download&confirm=t",
                    f"https://drive.google.com/uc?export=download&id={file_id}"]
    if "dropbox.com" in lowered:
        base = url.split("?", 1)[0]
        return [f"{base}?dl=1", url]
    if "1drv.ms" in lowered or "onedrive.live.com" in lowered:
        joiner = "&" if "?" in url else "?"
        return [f"{url}{joiner}download=1", url]
    return [url]


def _download_one(url: str, target: Path, report=None) -> int:
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT,
                                                   "Accept": "*/*"})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            declared = response.headers.get("Content-Length")
            total = int(declared) if declared and declared.isdigit() else 0
            if total > MAX_BYTES:
                raise FetchError(f"that link is {total / (1 << 30):.1f} GB; "
                                 f"a reference file should be an ordinary video")
            done = 0
            with open(target, "wb") as handle:
                while True:
                    block = response.read(CHUNK)
                    if not block:
                        break
                    done += len(block)
                    if done > MAX_BYTES:
                        raise FetchError("download passed 4 GB; that is not a reference file")
                    handle.write(block)
                    if report:
                        report(done, total)
    except urllib.error.HTTPError as exc:
        raise FetchError(f"{url} answered HTTP {exc.code} ({exc.reason})") from exc
    except urllib.error.URLError as exc:
        raise FetchError(f"could not reach {url}: {exc.reason}") from exc
    except TimeoutError as exc:
        raise FetchError(f"{url} timed out after {TIMEOUT}s") from exc
    return done


def download(url: str, dest_dir: Path, name_hint: str = "reference.mp4", report=None) -> Path:
    """Download `url` into `dest_dir`, returning the local file. Raises FetchError."""
    dest_dir = Path(dest_dir)
    dest_dir.mkdir(parents=True, exist_ok=True)
    suffix = Path(url.split("?", 1)[0]).suffix.lower()
    target = dest_dir / (Path(name_hint).stem + (suffix if suffix else ".mp4"))
    problems: list[str] = []
    for candidate in direct_candidates(url):
        try:
            size = _download_one(candidate, target, report)
        except FetchError as exc:
            problems.append(str(exc))
            continue
        if size == 0:
            problems.append(f"{candidate} returned an empty file")
            continue
        if not looks_like_media(target):
            problems.append(
                f"{candidate} returned a web page, not a video. A share link has to be made "
                f"public (\"anyone with the link\") or replaced by the direct download URL")
            continue
        return target
    target.unlink(missing_ok=True)
    raise FetchError("; ".join(problems) or f"nothing usable came back from {url}")


def describe(size: int) -> str:
    if size >= 1 << 30:
        return f"{size / (1 << 30):.1f} GB"
    if size >= 1 << 20:
        return f"{size / (1 << 20):.1f} MB"
    return f"{size / 1024:.0f} KB"


def cleanup(path: Path) -> None:
    """Remove a downloaded reference and the folder that held it."""
    try:
        shutil.rmtree(Path(path).parent, ignore_errors=True)
    except OSError:
        pass
